# CivicEye Backend — Environment Variables
# Copy this file to .env and fill in your values before starting the server.
# NEVER commit the actual .env file to source control.

# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/civiceye

# JWT signing secret — use a long random string in production (required)
JWT_SECRET=replace_with_a_long_random_secret

# JWT expiry (optional, default: 7d)
JWT_EXPIRES_IN=7d

# Server port (optional, default: 5000)
PORT=5000

# Allowed frontend origin for CORS (optional, default: http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Google Cloud Vision credentials (optional — Vision analysis is skipped gracefully if absent)
# Point to your service account JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Vision API timeout in milliseconds (optional, default: 10000)
VISION_TIMEOUT_MS=10000

# Maximum image upload size in MB (optional, default: 8)
MAX_UPLOAD_MB=8

# Password used when seeding admin accounts via `npm run seed` (optional, default: ChangeMe123!)
SEED_ADMIN_PASSWORD=ChangeMe123!

# Node environment (optional)
NODE_ENV=development
